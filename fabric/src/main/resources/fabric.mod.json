{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_url}/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.pockyl.handson_delight.fabric.HandsOnDelightFabric", "com.pockyl.handson_delight.fabric.FabricGameTests"],
    "client": ["com.pockyl.handson_delight.fabric.HandsOnDelightFabricClient"]
  },
  "mixins": ["handson_delight.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "farmersdelight": ">=${farmers_delight_version}",
    "diegesis": ">=${diegesis_version}"
  }
}
