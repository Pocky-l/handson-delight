{
  "multipart": [
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/body"
      }
    },
    {
      "when": {
        "facing": "up",
        "open": "false"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lid"
      }
    },
    {
      "when": {
        "facing": "up",
        "open": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lid_open"
      }
    },
    {
      "when": {
        "facing": "down",
        "open": "false"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_closed",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "down",
        "open": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_open",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "false"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_closed",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_open",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "open": "false"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_closed",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "open": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_open",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "false"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_closed",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_open",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "false"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_closed",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/vat/lying_open",
        "x": 90,
        "y": 270
      }
    }
  ]
}