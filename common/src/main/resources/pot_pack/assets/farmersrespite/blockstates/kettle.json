    },
    {
      "when": {
        "facing": "south",
        "support": "handle"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/hanger",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "support": "handle"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/hanger",
        "y": 270
