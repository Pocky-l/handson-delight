{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/body"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/body",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/body",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/body",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "lid": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/lid"
      }
    },
    {
      "when": {
        "facing": "east",
        "lid": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/lid",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "lid": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/lid",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "lid": "true"
      },
      "apply": {
        "model": "handson_delight:diegesis/kettle/lid",
        "y": 270
      }
    },
    {
      "when": {
        "support": "tray"
      },
      "apply": {
        "model": "handson_delight:diegesis/pot/tray"
      }
    },
    {
      "when": {
        "facing": "north",
