{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_url}/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.pockyl.handson_delight.fabric.HandsOnDelightFabric"],
    "client": ["com.pockyl.handson_delight.fabric.HandsOnDelightFabricClient"],
    "jei_mod_plugin": ["com.pockyl.handson_delight.compat.jei.HandsOnJeiPlugin"],
    "emi": ["com.pockyl.handson_delight.compat.emi.HandsOnEmiPlugin"],
    "rei_client": ["com.pockyl.handson_delight.fabric.rei.HandsOnReiPlugin"],
    "fabric-gametest": ["com.pockyl.handson_delight.fabric.FabricPotTests", "com.pockyl.handson_delight.fabric.FabricBoardTests",
      "com.pockyl.handson_delight.fabric.FabricSkilletTests",
      "com.pockyl.handson_delight.fabric.FabricStoveTests"]
  },
  "mixins": ["handson_delight.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "farmersdelight": ">=${farmers_delight_version}",
    "diegesis": ">=${diegesis_version}"
  }
}
